# this one is exposed from port 5001
# FROM python:3.10.4-slim-buster
FROM mlflow-base:latest


WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*


COPY requirements.txt .
# COPY deployement/install-pyenv-win.ps1 /app/deployement/
# COPY deployement/install-pyenv-linux.sh /app/deployement/
# COPY deployement/install-pyenv-mac.sh /app/deployement/

# Install pyenv
RUN git clone https://github.com/pyenv/pyenv.git ~/.pyenv
ENV PYENV_ROOT /root/.pyenv
ENV PATH $PYENV_ROOT/bin:$PATH

# Initialize pyenv in shell
RUN echo 'eval "$(pyenv init --path)"' >> ~/.bashrc
RUN echo 'eval "$(pyenv init -)"' >> ~/.bashrc
RUN /bin/bash -c "source ~/.bashrc"

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY deployement /app/deployement/
COPY data/ /app/data/

WORKDIR /app/deployement

COPY deployement/entrypoint.sh .
COPY deployement/workflow.py .
COPY deployement/get_embeddings.py .

# Make entrypoint executable
RUN chmod +x ./entrypoint.sh

EXPOSE 5001

CMD ["/bin/bash", "./entrypoint.sh"]